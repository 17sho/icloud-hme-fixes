# systemd unit — run icloud-hme behind a process supervisor.
# Place at /etc/systemd/system/icloud-hme.service
#
#   sudo cp deploy/icloud-hme.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now icloud-hme
#
# Replace "/opt/icloud-hme" and the User below with your real paths.
# REQUIRED: provide HME_ADMIN_PASSWORD (patch #4 login gate).

[Unit]
Description=iCloud HME management panel (patched)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust user/group and working dir to match your deployment.
User=www-data
Group=www-data
WorkingDirectory=/opt/icloud-hme
ExecStart=/opt/icloud-hme/.venv/bin/python web_ui.py --port 5050

# Secret admin password for the session login gate (patch #4).
# Better: load from a protected env file — see EnvironmentFile alternative below.
Environment=HME_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Prefer this over Environment= if you keep secrets in a root-only file:
# EnvironmentFile=/etc/icloud-hme.env
# (then remove the Environment= line above and put HME_ADMIN_PASSWORD=... there,
#  chmod 600 the env file)

Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/icloud-hme/results /opt/icloud-hme/logs

[Install]
WantedBy=multi-user.target

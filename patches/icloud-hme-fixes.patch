+    def renew_account(self, acc_id: str, cookie_input: str) -> Dict:
+        """用新的 iCloud Cookie 续期账号：先校验新 cookie，成功才写回。"""
+        from icloud_hme import ICloudHME
+
+        if acc_id not in self.accounts:
+            raise KeyError(f"账号不存在: {acc_id}")
+
+        cookies = self.parse_cookie_input(cookie_input)
+        account = self.accounts[acc_id]
+        host = account.get("host", "icloud.com")
+
+        # 先在内存中校验新 cookie（不覆盖原 cookie），成功才落盘
+        new_account = dict(account)
+        new_account["cookies"] = cookies
+        new_account["last_error"] = None
+        try:
+            client = ICloudHME(cookies, host=host, verbose=False)
+            client.validate_session()
+            info = client.get_account_info()
+            if info:
+                new_account["real_email"] = (
+                    info.get("appleId", "")
+                    or info.get("primaryEmail", "")
+                )
+                existing = new_account.get("icloud_email", "")
+                is_icloud = existing and any(
+                    d in existing for d in ("@icloud.com", "@me.com", "@mac.com")
+                )
+                if not is_icloud:
+                    new_account["icloud_email"] = self._derive_icloud_email(info)
+
+            try:
+                aliases = client.list_aliases()
+                new_account["alias_total"] = len(aliases)
+                new_account["alias_active"] = sum(
+                    1 for a in aliases if a.get("active")
+                )
+            except Exception:
+                pass
+
+            new_account["status"] = "active"
+            new_account["last_validated"] = datetime.now().isoformat()
+            new_account["last_error"] = None
+        except Exception as e:
+            # 校验失败：保留原 cookie，仅更新错误状态
+            account["status"] = "error"
+            account["last_error"] = str(e)[:300]
+            self._save()
+            return account
+
+        # 校验成功：写入新 cookie
+        self.accounts[acc_id] = new_account
+        self._save()
+        return new_account
+
